<!doctype html>
<html class="js full-height" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_heading_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>{{ shop.name }}</title>

    <meta name="description" content="{{ page_description | escape }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    %}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}

      {% for scheme in settings.color_schemes -%}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
        {% liquid
          assign fg_c = scheme.settings.text | default: scheme.settings.foreground
          assign btn_c = scheme.settings.button | default: scheme.settings.primary_button_background | default: scheme.settings.primary
          assign btn_label_c = scheme.settings.button_label | default: scheme.settings.primary_button_text
          assign sec_btn_label_c = scheme.settings.secondary_button_label | default: scheme.settings.secondary_button_text | default: scheme.settings.foreground
        %}
          --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
          {% if scheme.settings.background_gradient != blank %}--gradient-background: {{ scheme.settings.background_gradient }};{% else %}--gradient-background: {{ scheme.settings.background | default: '#ffffff' }};{% endif %}
          --color-foreground: {{ fg_c.red }},{{ fg_c.green }},{{ fg_c.blue }};
          --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};
          --color-button: {{ btn_c.red }},{{ btn_c.green }},{{ btn_c.blue }};
          --color-button-text: {{ btn_label_c.red }},{{ btn_label_c.green }},{{ btn_label_c.blue }};
          --color-secondary-button: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
          --color-secondary-button-text: {{ sec_btn_label_c.red }},{{ sec_btn_label_c.green }},{{ sec_btn_label_c.blue }};
          --color-link: {{ sec_btn_label_c.red }},{{ sec_btn_label_c.green }},{{ sec_btn_label_c.blue }};
          --color-badge-foreground: {{ fg_c.red }},{{ fg_c.green }},{{ fg_c.blue }};
          --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
          --color-badge-border: {{ fg_c.red }},{{ fg_c.green }},{{ fg_c.blue }};
          --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
        }
      {% endfor %}

      {{ scheme_classes | prepend: 'body' }} {
        color: rgba(var(--color-foreground), 0.75);
        background-color: rgb(var(--color-background));
      }

      :root {
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-style: {{ settings.type_body_font.style }};
        --font-body-weight: {{ settings.type_body_font.weight }};

        --font-heading-family: {{ settings.type_heading_font.family | default: settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families | default: settings.type_heading_font.fallback_families }};
        --font-heading-style: {{ settings.type_heading_font.style | default: settings.type_heading_font.style }};
        --font-heading-weight: {{ settings.type_heading_font.weight | default: settings.type_heading_font.weight }};

        --font-body-scale: {{ settings.body_scale | default: 100 | divided_by: 100.0 }};
        {%- assign body_scale_safe = settings.body_scale | default: 100 -%}{%- assign heading_scale_safe = settings.heading_scale | default: 100 -%}--font-heading-scale: {{ heading_scale_safe | times: 1.0 | divided_by: body_scale_safe }};
        --media-padding: {{ settings.media_padding | default: 0 }}px;
        --media-border-opacity: {{ settings.media_border_opacity | default: 100 | divided_by: 100.0 }};
        --media-border-width: {{ settings.media_border_thickness | default: 1 }}px;
        --media-radius: {{ settings.media_radius | default: 0 }}px;
        --media-shadow-opacity: {{ settings.media_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --media-shadow-horizontal-offset: {{ settings.media_shadow_horizontal_offset | default: 0 }}px;
        --media-shadow-vertical-offset: {{ settings.media_shadow_vertical_offset | default: 0 }}px;
        --media-shadow-blur-radius: {{ settings.media_shadow_blur | default: 0 }}px;
        --media-shadow-visible: {% if settings.media_shadow_opacity > 0 %}1{% else %}0{% endif %};

        {% case settings.page_width %}
          {% when 'narrow' %}
            --page-width: 120rem;
            --page-width-margin: 0rem;
          {% when 'wide' %}
            --page-width: 160rem;
            --page-width-margin: 2rem;
          {% else %}
            --page-width: 140rem;
            --page-width-margin: 0rem;
        {% endcase %}

        --product-card-image-padding: {{ settings.card_image_padding | default: 0 | divided_by: 10.0 }}rem;
        --product-card-corner-radius: {{ settings.card_corner_radius | default: 0 | divided_by: 10.0 }}rem;
        --product-card-text-alignment: {{ settings.card_text_alignment | default: 'left' }};
        --product-card-border-width: {{ settings.card_border_thickness | default: 1 | divided_by: 10.0 }}rem;
        --product-card-border-opacity: {{ settings.card_border_opacity | default: 100 | divided_by: 100.0 }};
        --product-card-shadow-opacity: {{ settings.card_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --product-card-shadow-visible: {% if settings.card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --product-card-shadow-horizontal-offset: {{ settings.card_shadow_horizontal_offset | default: 0 | divided_by: 10.0 }}rem;
        --product-card-shadow-vertical-offset: {{ settings.card_shadow_vertical_offset | default: 0 | divided_by: 10.0 }}rem;
        --product-card-shadow-blur-radius: {{ settings.card_shadow_blur | default: 0 | divided_by: 10.0 }}rem;

        --collection-card-image-padding: {{ settings.collection_card_image_padding | default: 0 | divided_by: 10.0 }}rem;
        --collection-card-corner-radius: {{ settings.collection_card_corner_radius | default: 0 | divided_by: 10.0 }}rem;
        --collection-card-text-alignment: {{ settings.collection_card_text_alignment | default: 'left' }};
        --collection-card-border-width: {{ settings.collection_card_border_thickness | default: 1 | divided_by: 10.0 }}rem;
        --collection-card-border-opacity: {{ settings.collection_card_border_opacity | default: 100 | divided_by: 100.0 }};
        --collection-card-shadow-opacity: {{ settings.collection_card_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --collection-card-shadow-visible: {% if settings.collection_card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --collection-card-shadow-horizontal-offset: {{ settings.collection_card_shadow_horizontal_offset | default: 0 | divided_by: 10.0 }}rem;
        --collection-card-shadow-vertical-offset: {{ settings.collection_card_shadow_vertical_offset | default: 0 | divided_by: 10.0 }}rem;
        --collection-card-shadow-blur-radius: {{ settings.collection_card_shadow_blur | default: 0 | divided_by: 10.0 }}rem;

        --blog-card-image-padding: {{ settings.blog_card_image_padding | default: 0 | divided_by: 10.0 }}rem;
        --blog-card-corner-radius: {{ settings.blog_card_corner_radius | default: 0 | divided_by: 10.0 }}rem;
        --blog-card-text-alignment: {{ settings.blog_card_text_alignment | default: 'left' }};
        --blog-card-border-width: {{ settings.blog_card_border_thickness | default: 1 | divided_by: 10.0 }}rem;
        --blog-card-border-opacity: {{ settings.blog_card_border_opacity | default: 100 | divided_by: 100.0 }};
        --blog-card-shadow-opacity: {{ settings.blog_card_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --blog-card-shadow-visible: {% if settings.blog_card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --blog-card-shadow-horizontal-offset: {{ settings.blog_card_shadow_horizontal_offset | default: 0 | divided_by: 10.0 }}rem;
        --blog-card-shadow-vertical-offset: {{ settings.blog_card_shadow_vertical_offset | default: 0 | divided_by: 10.0 }}rem;
        --blog-card-shadow-blur-radius: {{ settings.blog_card_shadow_blur | default: 0 | divided_by: 10.0 }}rem;

        --badge-corner-radius: {{ settings.badge_corner_radius | default: 40 | divided_by: 10.0 }}rem;

        --spacing-sections-desktop: {{ settings.spacing_sections | default: 0 }}px;
        --spacing-sections-mobile: {% assign spacing_sections_safe = settings.spacing_sections | default: 0 %}{% if spacing_sections_safe < 24 %}{{ spacing_sections_safe }}{% else %}{{ spacing_sections_safe | times: 0.7 | round | at_least: 20 }}{% endif %}px;

        --grid-desktop-vertical-spacing: {{ settings.spacing_grid_vertical | default: 8 }}px;
        --grid-desktop-horizontal-spacing: {{ settings.spacing_grid_horizontal | default: 8 }}px;
        --grid-mobile-vertical-spacing: {{ settings.spacing_grid_vertical | default: 8 | divided_by: 2 }}px;
        --grid-mobile-horizontal-spacing: {{ settings.spacing_grid_horizontal | default: 8 | divided_by: 2 }}px;

        --text-boxes-border-opacity: {{ settings.text_boxes_border_opacity | default: 100 | divided_by: 100.0 }};
        --text-boxes-border-width: {{ settings.text_boxes_border_thickness | default: 0 }}px;
        --text-boxes-radius: {{ settings.text_boxes_radius | default: 0 }}px;
        --text-boxes-shadow-opacity: {{ settings.text_boxes_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --text-boxes-shadow-visible: {% if settings.text_boxes_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --text-boxes-shadow-horizontal-offset: {{ settings.text_boxes_shadow_horizontal_offset | default: 0 }}px;
        --text-boxes-shadow-vertical-offset: {{ settings.text_boxes_shadow_vertical_offset | default: 0 }}px;
        --text-boxes-shadow-blur-radius: {{ settings.text_boxes_shadow_blur | default: 0 }}px;

        --buttons-radius: {{ settings.buttons_radius | default: settings.button_border_radius_primary | default: 0 }}px;
        --buttons-radius-outset: {% assign buttons_radius_safe = settings.buttons_radius | default: settings.button_border_radius_primary | default: 0 %}{% assign buttons_border_safe = settings.buttons_border_thickness | default: settings.primary_button_border_width | default: 0 %}{% if buttons_radius_safe > 0 %}{{ buttons_radius_safe | plus: buttons_border_safe }}{% else %}0{% endif %}px;
        --buttons-border-width: {% if settings.buttons_border_opacity > 0 %}{{ settings.buttons_border_thickness | default: settings.primary_button_border_width | default: 0 }}{% else %}0{% endif %}px;
        --buttons-border-opacity: {{ settings.buttons_border_opacity | default: 100 | divided_by: 100.0 }};
        --buttons-shadow-opacity: {{ settings.buttons_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --buttons-shadow-visible: {% if settings.buttons_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --buttons-shadow-horizontal-offset: {{ settings.buttons_shadow_horizontal_offset | default: 0 }}px;
        --buttons-shadow-vertical-offset: {{ settings.buttons_shadow_vertical_offset | default: 0 }}px;
        --buttons-shadow-blur-radius: {{ settings.buttons_shadow_blur | default: 0 }}px;
        --buttons-border-offset: {% if buttons_radius_safe > 0 or settings.buttons_shadow_opacity > 0 %}0.3{% else %}0{% endif %}px;

        --inputs-radius: {{ settings.inputs_radius | default: settings.inputs_border_radius | default: 8 }}px;
        --inputs-border-width: {{ settings.inputs_border_thickness | default: settings.input_border_width | default: 1 }}px;
        --inputs-border-opacity: {{ settings.inputs_border_opacity | default: 100 | divided_by: 100.0 }};
        --inputs-shadow-opacity: {{ settings.inputs_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --inputs-shadow-horizontal-offset: {{ settings.inputs_shadow_horizontal_offset | default: 0 }}px;
        --inputs-margin-offset: {% assign inputs_shadow_v_safe = settings.inputs_shadow_vertical_offset | default: 0 %}{% if inputs_shadow_v_safe != 0 and settings.inputs_shadow_opacity > 0 %}{{ inputs_shadow_v_safe | abs }}{% else %}0{% endif %}px;
        --inputs-shadow-vertical-offset: {{ settings.inputs_shadow_vertical_offset | default: 0 }}px;
        --inputs-shadow-blur-radius: {{ settings.inputs_shadow_blur | default: 0 }}px;
        --inputs-radius-outset: {% assign inputs_radius_safe = settings.inputs_radius | default: settings.inputs_border_radius | default: 8 %}{% assign inputs_border_safe = settings.inputs_border_thickness | default: settings.input_border_width | default: 1 %}{% if inputs_radius_safe > 0 %}{{ inputs_radius_safe | plus: inputs_border_safe }}{% else %}0{% endif %}px;

        --variant-pills-radius: {{ settings.variant_pills_radius | default: settings.pills_border_radius | default: 40 }}px;
        --variant-pills-border-width: {{ settings.variant_pills_border_thickness | default: settings.variant_button_border_width | default: 1 }}px;
        --variant-pills-border-opacity: {{ settings.variant_pills_border_opacity | default: 100 | divided_by: 100.0 }};
        --variant-pills-shadow-opacity: {{ settings.variant_pills_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --variant-pills-shadow-horizontal-offset: {{ settings.variant_pills_shadow_horizontal_offset | default: 0 }}px;
        --variant-pills-shadow-vertical-offset: {{ settings.variant_pills_shadow_vertical_offset | default: 0 }}px;
        --variant-pills-shadow-blur-radius: {{ settings.variant_pills_shadow_blur | default: 0 }}px;
      }
    {% endstyle %}

    {%- unless settings.type_body_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}
    {%- unless settings.type_heading_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_heading_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}

    {{ 'section-password.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component-list-social.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'password-modal.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="password gradient">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% section 'main-password-header' %}

    <main id="MainContent" class="password-main">
      {{ content_for_layout }}
    </main>
    <footer>
      {% section 'main-password-footer' %}
    </footer>
    <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
  </body>
</html>
