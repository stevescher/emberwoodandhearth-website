{%- doc -%}
  Candle Flight scent picker.

  Trays are the product's variants. The selected variant decides how many
  candles the customer picks and at what size. On submit the block adds the
  matching tray variant plus one line item per chosen candle, and never the
  Flight variant itself. Shopify automatic discounts do the pricing.

  Tray variant IDs are read from the tray product named in the block settings
  by matching variant titles, so they are not hardcoded.
{%- enddoc -%}

{% liquid
  assign flight_product = closest.product
  if request.visual_preview_mode and flight_product == blank
    assign flight_product = collections.all.products.first
  endif

  assign scent_collection = block.settings.scent_collection
  assign tray_product = all_products[block.settings.tray_product_handle]
%}

{%- if flight_product != blank -%}
  {%- liquid
    assign tray_id_2 = ''
    assign tray_id_3 = ''
    assign tray_id_small_3 = ''

    for tv in tray_product.variants
      assign tvl = tv.title | downcase
      if tvl contains 'small'
        assign tray_id_small_3 = tv.id
      elsif tvl contains 'three' or tvl contains '3'
        assign tray_id_3 = tv.id
      elsif tvl contains 'two' or tvl contains '2'
        assign tray_id_2 = tv.id
      endif
    endfor
  -%}

  <div class="scent-picker" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
    <script type="application/json" data-scent-picker-variants>
      [
        {%- for v in flight_product.variants -%}
          {%- liquid
            assign vl = v.title | downcase
            if vl contains 'small'
              assign v_count = 3
              assign v_tray = tray_id_small_3
              assign v_size = '6oz'
            elsif vl contains 'three' or vl contains '3'
              assign v_count = 3
              assign v_tray = tray_id_3
              assign v_size = '10oz'
            else
              assign v_count = 2
              assign v_tray = tray_id_2
              assign v_size = '10oz'
            endif
          -%}
          {
            "id": {{ v.id | json }},
            "scentCount": {{ v_count }},
            "trayId": {{ v_tray | json }},
            "candleSize": {{ v_size | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>

    <div class="scent-picker__header">
      <span class="scent-picker__label">{{ block.settings.heading }}</span>
      <span class="scent-picker__counter" data-scent-picker-counter aria-live="polite"></span>
    </div>

    <div class="scent-picker__grid" data-scent-picker-grid role="group" aria-label="{{ block.settings.heading | escape }}">
      {%- for scent in scent_collection.products -%}
        {%- liquid
          assign v6 = ''
          assign v10 = ''
          assign v12 = ''
          assign a6 = false
          assign a10 = false
          assign a12 = false
          for sv in scent.variants
            assign svl = sv.title | downcase | remove: ' '
            if svl == '6oz'
              assign v6 = sv.id
              assign a6 = sv.available
            elsif svl == '10oz'
              assign v10 = sv.id
              assign a10 = sv.available
            elsif svl == '12oz'
              assign v12 = sv.id
              assign a12 = sv.available
            endif
          endfor
        -%}
        <label class="scent-picker__pill">
          <input
            type="checkbox"
            class="scent-picker__checkbox"
            value="{{ scent.title | escape }}"
            data-variant-6oz="{{ v6 }}"
            data-variant-10oz="{{ v10 }}"
            data-variant-12oz="{{ v12 }}"
            data-available-6oz="{{ a6 }}"
            data-available-10oz="{{ a10 }}"
            data-available-12oz="{{ a12 }}"
          >
          <span class="scent-picker__pill-label">{{ scent.title | escape }}</span>
        </label>
      {%- else -%}
        <p class="scent-picker__empty">
          No scents available. Add products to the selected collection.
        </p>
      {%- endfor -%}
    </div>

    <button
      type="button"
      class="scent-picker__submit button"
      data-scent-picker-submit
    >
      {{ block.settings.button_label }}
    </button>

    <p class="scent-picker__error" data-scent-picker-error role="alert" hidden></p>
  </div>


  <script>
    (() => {
      const root = document.querySelector('.scent-picker[data-block-id="{{ block.id }}"]');
      if (!root || root.dataset.scentPickerReady === 'true') return;
      root.dataset.scentPickerReady = 'true';

      const variants = JSON.parse(root.querySelector('[data-scent-picker-variants]').textContent);
      const section = root.closest('.shopify-section') || document;
      let selected = [];

      // A variant change re-renders the section through morph.js, which
      // replaces nodes without re-running inline scripts (see morph.js:588).
      // So never cache element references: resolve them on every use, and
      // delegate listeners from `root`, which survives the morph.
      const counter = () => root.querySelector('[data-scent-picker-counter]');
      const submit = () => root.querySelector('[data-scent-picker-submit]');
      const errorEl = () => root.querySelector('[data-scent-picker-error]');

      const checkboxes = () => Array.from(root.querySelectorAll('.scent-picker__checkbox'));

      // This page has no buy-buttons block (the picker owns add-to-cart), so
      // there is no form [name="id"] to read. The variant picker reflects the
      // selection into the URL and its own checked input, so use those.
      const currentVariantId = () => {
        const fromUrl = new URLSearchParams(window.location.search).get('variant');
        if (fromUrl) return parseInt(fromUrl, 10);

        const checked = section.querySelector('variant-picker input:checked, .variant-picker input:checked');
        if (checked?.dataset.variantId) return parseInt(checked.dataset.variantId, 10);

        const initial = {{ flight_product.selected_or_first_available_variant.id | json }};
        return initial ? parseInt(initial, 10) : null;
      };

      const currentConfig = () => {
        const id = currentVariantId();
        return variants.find((v) => v.id === id) || variants[0];
      };

      const variantIdForSize = (checkbox, size) => {
        const key = String(size).toLowerCase().replace(/\s/g, '');
        const id = checkbox.dataset['variant' + key.charAt(0).toUpperCase() + key.slice(1)];
        const available = checkbox.dataset['available' + key.charAt(0).toUpperCase() + key.slice(1)];
        return id && available === 'true' ? parseInt(id, 10) : null;
      };

      const showError = (message) => {
        const el = errorEl();
        if (!el) return;
        el.textContent = message;
        el.hidden = false;
      };

      const clearError = () => {
        const el = errorEl();
        if (el) el.hidden = true;
      };

      const refresh = () => {
        const required = currentConfig().scentCount;
        const counterEl = counter();
        if (counterEl) counterEl.textContent = `${selected.length} of ${required} selected`;

        const complete = selected.length === required;
        const submitEl = submit();
        if (submitEl) submitEl.disabled = !complete;

        checkboxes().forEach((cb) => {
          // Re-apply checked state after a morph replaces the inputs.
          cb.checked = selected.includes(cb.value);
          cb.disabled = selected.length >= required && !cb.checked;
        });
      };

      const reset = () => {
        selected = [];
        clearError();
        refresh();
      };

      root.addEventListener('change', (event) => {
        const cb = event.target;
        if (!cb.classList || !cb.classList.contains('scent-picker__checkbox')) return;

        const required = currentConfig().scentCount;
        if (cb.checked) {
          if (selected.length >= required) {
            cb.checked = false;
            return;
          }
          selected.push(cb.value);
        } else {
          selected = selected.filter((name) => name !== cb.value);
        }
        clearError();
        refresh();
      });

      // Switching tray variants changes the required count and candle size,
      // so a partial selection is no longer valid. The section re-render also
      // drops the markup, so re-apply state afterwards.
      let lastVariantId = currentVariantId();
      const onVariantChange = () => {
        const id = currentVariantId();
        if (id === lastVariantId) {
          refresh();
          return;
        }
        lastVariantId = id;
        reset();
      };

      // variant-picker.js dispatches ProductSelectEvent, whose type resolves to
      // 'shopify:product:select' and bubbles, so document catches it. The morph
      // that follows lands after this fires, hence the rAF re-sync below.
      document.addEventListener('shopify:product:select', () => {
        onVariantChange();
        requestAnimationFrame(refresh);
      });

      root.addEventListener('click', async (event) => {
        const trigger = event.target.closest('[data-scent-picker-submit]');
        if (!trigger) return;

        const config = currentConfig();
        const required = config.scentCount;

        if (selected.length !== required) {
          showError(`Please select ${required} scents.`);
          return;
        }

        if (!config.trayId) {
          showError('Tray not configured. Please contact us.');
          return;
        }

        const items = [{ id: parseInt(config.trayId, 10), quantity: 1 }];
        for (const name of selected) {
          const cb = checkboxes().find((c) => c.value === name);
          const id = cb ? variantIdForSize(cb, config.candleSize) : null;
          if (!id) {
            showError('One or more scents is not available in this size. Please contact us.');
            return;
          }
          items.push({ id, quantity: 1 });
        }

        const originalLabel = trigger.textContent;
        trigger.disabled = true;
        trigger.textContent = 'Adding\u2026';
        clearError();

        try {
          const addUrl = (window.Theme && Theme.routes && Theme.routes.cart_add_url) || '/cart/add';
          const response = await fetch(`${addUrl}.js`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({ items }),
          });

          const data = await response.json();
          if (!response.ok || data.status) {
            throw new Error(data.description || data.message || 'Could not add to cart.');
          }

          // Standard Shopify cart event (resolved from @shopify/events) so the
          // cart drawer, cart icon and any other listeners refresh.
          document.dispatchEvent(
            new CustomEvent('shopify:cart:lines-update', {
              bubbles: true,
              detail: { source: 'scent-picker', items: data.items || [] },
            })
          );

          reset();
          trigger.textContent = 'Added';
          setTimeout(() => {
            trigger.textContent = originalLabel;
            refresh();
          }, 2000);
        } catch (error) {
          showError(error.message || 'Something went wrong.');
          trigger.textContent = originalLabel;
          refresh();
        }
      });

      refresh();
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .scent-picker {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.75rem);
  }

  .scent-picker__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .scent-picker__label {
    font-weight: 600;
  }

  .scent-picker__counter,
  .scent-picker__empty {
    color: var(--color-foreground-subdued);
    font-size: 0.875rem;
  }

  .scent-picker__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .scent-picker__pill {
    display: inline-flex;
    cursor: pointer;
  }

  .scent-picker__checkbox {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .scent-picker__pill-label {
    display: inline-block;
    padding: 0.5rem 1.125rem;
    border: var(--style-border-width-inputs, 1px) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs, 4rem);
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    font-size: 0.875rem;
    line-height: 1.2;
    transition: background-color var(--animation-speed, 0.1s) var(--animation-easing, ease),
      border-color var(--animation-speed, 0.1s) var(--animation-easing, ease),
      color var(--animation-speed, 0.1s) var(--animation-easing, ease);
  }

  .scent-picker__pill:has(.scent-picker__checkbox:checked) .scent-picker__pill-label {
    background-color: var(--color-selected-variant-background);
    border-color: var(--color-selected-variant-border);
    color: var(--color-selected-variant-text);
  }

  .scent-picker__pill:has(.scent-picker__checkbox:focus-visible) .scent-picker__pill-label {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .scent-picker__pill:has(.scent-picker__checkbox:disabled:not(:checked)) .scent-picker__pill-label {
    background-color: var(--input-disabled-background-color);
    border-color: var(--input-disabled-border-color);
    color: var(--input-disabled-text-color);
    cursor: not-allowed;
  }

  .scent-picker__submit[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .scent-picker__error {
    color: var(--color-error, var(--color-foreground));
    font-size: 0.875rem;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scent picker",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose your scents"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "collection",
      "id": "scent_collection",
      "label": "Scent collection",
      "info": "Products shown as selectable scents. Each needs 6oz / 10oz / 12oz variants."
    },
    {
      "type": "text",
      "id": "tray_product_handle",
      "label": "Tray product handle",
      "default": "candle-tray",
      "info": "Handle of the tray product, e.g. candle-tray. A product-type setting cannot be used here: it would override the block's product context. Tray variants are matched by title: 'Two', 'Three', 'Small Three'."
    }
  ],
  "presets": [
    {
      "name": "Scent picker",
      "category": "Product"
    }
  ]
}
{% endschema %}
