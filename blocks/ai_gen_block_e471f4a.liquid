  "name": "Split slideshow",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "slide_height", "label": "Slide height", "min": 320, "max": 760, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F1EDE8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#5A633F" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder", "default": "#E5E0D9" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#5C5C5C" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
