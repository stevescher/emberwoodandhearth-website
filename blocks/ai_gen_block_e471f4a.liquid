    { "type": "url", "id": "slide_1_link", "label": "Button link" },
    { "type": "header", "content": "Slide 2" },
    { "type": "image_picker", "id": "slide_2_image", "label": "Image" },
    { "type": "text", "id": "slide_2_eyebrow", "label": "Eyebrow", "default": "Seasonal ritual" },
    { "type": "text", "id": "slide_2_heading", "label": "Heading", "default": "Set the evening aglow" },
    { "type": "textarea", "id": "slide_2_body", "label": "Body", "default": "Discover warm, layered scents designed to make home feel like yours." },
    { "type": "text", "id": "slide_2_button", "label": "Button label", "default": "Explore scents" },
    { "type": "url", "id": "slide_2_link", "label": "Button link" },
    { "type": "header", "content": "Slide 3" },
    { "type": "image_picker", "id": "slide_3_image", "label": "Image" },
    { "type": "text", "id": "slide_3_eyebrow", "label": "Eyebrow", "default": "Made with intention" },
    { "type": "text", "id": "slide_3_heading", "label": "Heading", "default": "Small details, lasting atmosphere" },
    { "type": "textarea", "id": "slide_3_body", "label": "Body", "default": "Beautifully finished pieces for gifting, gathering, and everyday calm." },
    { "type": "text", "id": "slide_3_button", "label": "Button label", "default": "View bestsellers" },
    { "type": "url", "id": "slide_3_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Split slideshow" }],
  "tag": null,
