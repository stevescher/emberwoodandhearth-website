{% doc %}
  @prompt
    I want a slide show that has an image on the left and text on the right. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-slideshow-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-split-slideshow-{{ ai_gen_id }}__viewport {
    position: relative;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__slide {
    display: none;
    grid-template-columns: 1fr 1fr;
    min-height: {{ block.settings.slide_height }}px;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__slide.is-active {
    display: grid;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__media,
  .ai-split-slideshow-{{ ai_gen_id }}__placeholder {
    min-height: {{ block.settings.slide_height }}px;
    width: 100%;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__media {
    display: block;
    object-fit: cover;
    height: 100%;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-split-slideshow-{{ ai_gen_id }}__placeholder svg {
    width: 70%;
    height: 70%;
    color: {{ block.settings.muted_text_color }};
  }

  .ai-split-slideshow-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(28px, 6vw, 76px);
  }

  .ai-split-slideshow-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 14px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: {{ block.settings.text_color }};
    font-family: Georgia, serif;
    font-size: clamp(30px, 4vw, 56px);
    line-height: 1.08;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__body {
    max-width: 460px;
    margin: 0 0 28px;
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 24px;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-weight: 600;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__button:focus-visible,
  .ai-split-slideshow-{{ ai_gen_id }}__control:focus-visible {
    outline: 3px solid {{ block.settings.accent_color }};
    outline-offset: 3px;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__controls {
    position: absolute;
    right: 22px;
    bottom: 22px;
    display: flex;
    gap: 8px;
  }

  .ai-split-slideshow-{{ ai_gen_id }}__control {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 50%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    cursor: pointer;
    font-size: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-split-slideshow-{{ ai_gen_id }}__slide,
    .ai-split-slideshow-{{ ai_gen_id }}__slide.is-active {
      grid-template-columns: 1fr;
    }

    .ai-split-slideshow-{{ ai_gen_id }}__media,
    .ai-split-slideshow-{{ ai_gen_id }}__placeholder {
      min-height: 280px;
    }

    .ai-split-slideshow-{{ ai_gen_id }}__content {
      min-height: 300px;
      padding: 36px 28px 76px;
    }
  }
{% endstyle %}

<split-slideshow-{{ ai_gen_id }} class="ai-split-slideshow-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-slideshow-{{ ai_gen_id }}__viewport" aria-live="polite">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'slide_' | append: i | append: '_image'
        assign eyebrow_key = 'slide_' | append: i | append: '_eyebrow'
        assign heading_key = 'slide_' | append: i | append: '_heading'
        assign body_key = 'slide_' | append: i | append: '_body'
        assign button_key = 'slide_' | append: i | append: '_button'
        assign link_key = 'slide_' | append: i | append: '_link'
        assign image = block.settings[image_key]
        assign eyebrow = block.settings[eyebrow_key]
        assign heading = block.settings[heading_key]
        assign body = block.settings[body_key]
        assign button = block.settings[button_key]
        assign link = block.settings[link_key]
      %}
      <article class="ai-split-slideshow-{{ ai_gen_id }}__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ i }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
        {% if image != blank %}
          <img class="ai-split-slideshow-{{ ai_gen_id }}__media" src="{{ image | image_url: width: 1400 }}" alt="{{ image.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="{{ image.width }}" height="{{ image.height }}">
        {% else %}
          <div class="ai-split-slideshow-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
        {% endif %}
        <div class="ai-split-slideshow-{{ ai_gen_id }}__content">
          {% if eyebrow != blank %}<p class="ai-split-slideshow-{{ ai_gen_id }}__eyebrow">{{ eyebrow }}</p>{% endif %}
          {% if heading != blank %}<h2 class="ai-split-slideshow-{{ ai_gen_id }}__heading">{{ heading }}</h2>{% endif %}
          {% if body != blank %}<div class="ai-split-slideshow-{{ ai_gen_id }}__body">{{ body }}</div>{% endif %}
          {% if button != blank and link != blank %}<a class="ai-split-slideshow-{{ ai_gen_id }}__button" href="{{ link }}">{{ button }}</a>{% endif %}
        </div>
      </article>
    {% endfor %}
    <div class="ai-split-slideshow-{{ ai_gen_id }}__controls">
      <button class="ai-split-slideshow-{{ ai_gen_id }}__control" type="button" data-direction="previous" aria-label="Previous slide">&#8592;</button>
      <button class="ai-split-slideshow-{{ ai_gen_id }}__control" type="button" data-direction="next" aria-label="Next slide">&#8594;</button>
    </div>
  </div>
</split-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class SplitSlideshow{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('[data-slide]'));
        this.index = 0;
        this.querySelectorAll('[data-direction]').forEach((button) => {
          button.addEventListener('click', () => this.change(button.dataset.direction));
        });
      }
      change(direction) {
        this.slides[this.index].classList.remove('is-active');
        this.slides[this.index].setAttribute('aria-hidden', 'true');
        this.index = direction === 'next' ? (this.index + 1) % this.slides.length : (this.index - 1 + this.slides.length) % this.slides.length;
        this.slides[this.index].classList.add('is-active');
        this.slides[this.index].setAttribute('aria-hidden', 'false');
      }
    }
    customElements.define('split-slideshow-{{ ai_gen_id }}', SplitSlideshow{{ ai_gen_id }});
  })();
</script>

{% schema %}
