{% doc %}
  @prompt
    Create a new Multicolumn section where each column block has a built-in SVG icon field, a heading, and a text area. The SVG icon should display above the heading, be customizable in size (around 48px default) and color, and render cleanly with a transparent background. The layout should be a clean, evenly spaced grid matching a premium home fragrance brand aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-multicolumn-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-icon-multicolumn-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-icon-multicolumn-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    margin-top: {{ block.settings.content_spacing }}px;
  }

  .ai-icon-multicolumn-column-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    display: flex;
    flex-direction: column;
  }

  {% if block.settings.text_alignment == 'center' %}
    .ai-icon-multicolumn-column-{{ ai_gen_id }} {
      align-items: center;
    }
  {% elsif block.settings.text_alignment == 'right' %}
    .ai-icon-multicolumn-column-{{ ai_gen_id }} {
      align-items: flex-end;
    }
  {% else %}
    .ai-icon-multicolumn-column-{{ ai_gen_id }} {
      align-items: flex-start;
    }
  {% endif %}

  .ai-icon-multicolumn-icon-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.icon_spacing }}px;
  }

  .ai-icon-multicolumn-icon-wrapper-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: block;
  }

  .ai-icon-multicolumn-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    line-height: 1.3;
  }

  .ai-icon-multicolumn-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-icon-multicolumn-section-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.section_heading_alignment }};
    margin: 0 0 {{ block.settings.section_heading_spacing }}px;
    font-size: {{ block.settings.section_heading_size }}px;
    font-weight: {{ block.settings.section_heading_weight }};
    color: {{ block.settings.section_heading_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-icon-multicolumn-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-icon-multicolumn-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap | times: 0.75 }}px;
    }

    .ai-icon-multicolumn-icon-wrapper-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.85 }}px;
      height: {{ block.settings.icon_size | times: 0.85 }}px;
    }

    .ai-icon-multicolumn-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .ai-icon-multicolumn-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.95 }}px;
    }
  }
{% endstyle %}

<icon-multicolumn-{{ ai_gen_id }} class="ai-icon-multicolumn-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-multicolumn-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-icon-multicolumn-section-heading-{{ ai_gen_id }}">
        {{ block.settings.section_heading }}
      </h2>
    {% endif %}

    <div class="ai-icon-multicolumn-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign column_enabled_key = 'column_' | append: i | append: '_enabled'
          assign column_svg_key = 'column_' | append: i | append: '_svg'
          assign column_icon_color_key = 'column_' | append: i | append: '_icon_color'
          assign column_heading_key = 'column_' | append: i | append: '_heading'
          assign column_text_key = 'column_' | append: i | append: '_text'

          assign column_enabled = block.settings[column_enabled_key]
          assign column_svg = block.settings[column_svg_key]
          assign column_icon_color = block.settings[column_icon_color_key]
          assign column_heading = block.settings[column_heading_key]
          assign column_text = block.settings[column_text_key]
        %}

        {% if column_enabled %}
          <div class="ai-icon-multicolumn-column-{{ ai_gen_id }}">
            {% if column_svg != blank %}
              <div class="ai-icon-multicolumn-icon-wrapper-{{ ai_gen_id }}" style="color: {{ column_icon_color }};">
                {{ column_svg }}
              </div>
            {% endif %}

            {% if column_heading != blank %}
              <h3 class="ai-icon-multicolumn-heading-{{ ai_gen_id }}">
                {{ column_heading }}
              </h3>
            {% endif %}

            {% if column_text != blank %}
              <div class="ai-icon-multicolumn-text-{{ ai_gen_id }}">
                {{ column_text }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</icon-multicolumn-{{ ai_gen_id }}>

<script>
  (function() {
    class IconMulticolumn{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.applyIconColors();
      }

      applyIconColors() {
        const iconWrappers = this.querySelectorAll('.ai-icon-multicolumn-icon-wrapper-{{ ai_gen_id }}');
        iconWrappers.forEach((wrapper) => {
          const svg = wrapper.querySelector('svg');
          if (svg) {
            const color = wrapper.style.color;
            svg.style.fill = color;
            svg.style.stroke = 'none';
            
            const paths = svg.querySelectorAll('path, circle, rect, polygon, polyline, ellipse, line');
            paths.forEach((path) => {
              if (!path.hasAttribute('fill') || path.getAttribute('fill') !== 'none') {
                path.style.fill = color;
              }
              if (path.hasAttribute('stroke') && path.getAttribute('stroke') !== 'none') {
                path.style.stroke = color;
              }
            });
          }
        });
      }
    }

    customElements.define('icon-multicolumn-{{ ai_gen_id }}', IconMulticolumn{{ ai_gen_id }});
  })();
</script>

