{% doc %}
  @prompt
    Create a carousel/slideshow section where each slide displays an image on one side and text content on the other side (side-by-side layout, not image as background). Each slide should have: a product or lifestyle image, a heading, body text, and an optional button/CTA link. The carousel should have prev/next navigation arrows and dot indicators. The image and text sides should alternate or be configurable (image left or image right). Style should be clean and premium, suitable for a luxury candle and home fragrance brand with warm amber and gold tones. Should be fully responsive — stacks vertically on mobile., can you make it smaller. it takes up too much space vertically, can you make it so you can't see the other sections when you're on one of them. currently I see the text and image of the other sections which is distracting. , I still see the text from the other sections appear. also can you add a pause button on the carousel, can you make sure you're making this same design workable for mobile, for mobile we can just have the image centered. desktop we can have it on the left or right, perfect and on mobile lets make sure we're wrapping the text so it appears under the image please, text is still getting cut off on mobile, text is still getting cut off on mobile. make the text wrap so it appears under the image fitting into the width of the dic, ok so each slide should be contained. not go into the other slide. , lets move the arrows to where the dots are so they do not get in the way of the images and text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-carousel-container-{{ ai_gen_id }} {
    position: relative;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    min-width: 100%;
    max-width: 100%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    flex-direction: row;
    box-sizing: border-box;
  }

  .ai-carousel-slide-{{ ai_gen_id }}.reverse {
    flex-direction: row-reverse;
  }

  .ai-carousel-image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    min-width: 0;
  }

  .ai-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    max-height: {{ block.settings.image_max_height }}px;
    object-fit: cover;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-carousel-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_max_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-carousel-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-carousel-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    min-width: 0;
    overflow: hidden;
  }

  .ai-carousel-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .ai-carousel-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .ai-carousel-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 28px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 15px;
    font-weight: 500;
    transition: all 0.3s ease;
    align-self: flex-start;
    border: 1px solid {{ block.settings.button_bg_color }};
  }

  .ai-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};
    color: {{ block.settings.arrow_hover_color }};
    transform: scale(1.1);
  }

  .ai-carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-carousel-nav-{{ ai_gen_id }}:disabled:hover {
    transform: scale(1);
  }

  .ai-carousel-nav-{{ ai_gen_id }} svg {
    width: 22px;
    height: 22px;
  }

  .ai-carousel-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  .ai-carousel-pause-{{ ai_gen_id }} {
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-carousel-pause-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_bg_color }};
    color: {{ block.settings.arrow_hover_color }};
    transform: scale(1.1);
  }

  .ai-carousel-pause-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  .ai-carousel-pause-{{ ai_gen_id }} .pause-icon {
    display: block;
  }

  .ai-carousel-pause-{{ ai_gen_id }} .play-icon {
    display: none;
  }

  .ai-carousel-pause-{{ ai_gen_id }}.paused .pause-icon {
    display: none;
  }

  .ai-carousel-pause-{{ ai_gen_id }}.paused .play-icon {
    display: block;
  }

  .ai-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
    opacity: 0.4;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-carousel-dot-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 0;
    }

    .ai-carousel-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-carousel-slide-{{ ai_gen_id }},
    .ai-carousel-slide-{{ ai_gen_id }}.reverse {
      flex-direction: column;
      gap: 20px;
      align-items: stretch;
    }

    .ai-carousel-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      flex: none;
    }

    .ai-carousel-content-{{ ai_gen_id }} {
      width: 100%;
      flex: none;
      text-align: center;
      align-items: center;
      padding: 0;
      max-width: 100%;
      box-sizing: border-box;
    }

    .ai-carousel-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.65);
      width: 100%;
      max-width: 100%;
    }

    .ai-carousel-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    .ai-carousel-image-{{ ai_gen_id }} {
      max-height: 280px;
      width: 100%;
    }

    .ai-carousel-image-placeholder-{{ ai_gen_id }} {
      height: 280px;
      width: 100%;
    }

    .ai-carousel-nav-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .ai-carousel-nav-{{ ai_gen_id }} svg {
      width: 18px;
      height: 18px;
    }

    .ai-carousel-button-{{ ai_gen_id }} {
      padding: 10px 24px;
      font-size: 14px;
      width: 100%;
      max-width: 100%;
      text-align: center;
      box-sizing: border-box;
    }

    .ai-carousel-content-{{ ai_gen_id }} {
      gap: 12px;
    }

    .ai-carousel-pause-{{ ai_gen_id }} {
      width: 32px;
      height: 32px;
    }

    .ai-carousel-pause-{{ ai_gen_id }} svg {
      width: 16px;
      height: 16px;
    }

    .ai-carousel-controls-{{ ai_gen_id }} {
      margin-top: 20px;
      gap: 12px;
    }

    .ai-carousel-dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
    }

    .ai-carousel-dots-{{ ai_gen_id }} {
      gap: 8px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-carousel-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.55);
    }

    .ai-carousel-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.85);
    }

    .ai-carousel-image-{{ ai_gen_id }} {
      max-height: 240px;
    }

    .ai-carousel-image-placeholder-{{ ai_gen_id }} {
      height: 240px;
    }

    .ai-carousel-button-{{ ai_gen_id }} {
      padding: 9px 20px;
      font-size: 13px;
    }
  }
{% endstyle %}

<image-text-carousel-{{ ai_gen_id }} class="ai-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-carousel-container-{{ ai_gen_id }}">
    <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-carousel-track-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
            assign slide_image_key = 'slide_' | append: i | append: '_image'
            assign slide_heading_key = 'slide_' | append: i | append: '_heading'
            assign slide_text_key = 'slide_' | append: i | append: '_text'
            assign slide_button_text_key = 'slide_' | append: i | append: '_button_text'
            assign slide_button_link_key = 'slide_' | append: i | append: '_button_link'
            assign slide_layout_key = 'slide_' | append: i | append: '_layout'

            assign slide_enabled = block.settings[slide_enabled_key]
            assign slide_image = block.settings[slide_image_key]
            assign slide_heading = block.settings[slide_heading_key]
            assign slide_text = block.settings[slide_text_key]
            assign slide_button_text = block.settings[slide_button_text_key]
            assign slide_button_link = block.settings[slide_button_link_key]
            assign slide_layout = block.settings[slide_layout_key]
          %}

          {% if slide_enabled %}
            <div class="ai-carousel-slide-{{ ai_gen_id }} {% if slide_layout == 'image_right' %}reverse{% endif %}" data-slide="{{ i }}">
              <div class="ai-carousel-image-wrapper-{{ ai_gen_id }}">
                {% if slide_image %}
                  <img
                    src="{{ slide_image | image_url: width: 1200 }}"
                    alt="{{ slide_image.alt | escape }}"
                    loading="lazy"
                    width="{{ slide_image.width }}"
                    height="{{ slide_image.height }}"
                    class="ai-carousel-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-carousel-image-placeholder-{{ ai_gen_id }}">
                    {{ 'lifestyle-1' | placeholder_svg_tag }}
                    <div class="ai-carousel-empty-state-{{ ai_gen_id }}">
                      Add an image for slide {{ i }}
                    </div>
                  </div>
                {% endif %}
              </div>

              <div class="ai-carousel-content-{{ ai_gen_id }}">
                {% if slide_heading != blank %}
                  <h2 class="ai-carousel-heading-{{ ai_gen_id }}">{{ slide_heading }}</h2>
                {% endif %}

                {% if slide_text != blank %}
                  <div class="ai-carousel-text-{{ ai_gen_id }}">{{ slide_text }}</div>
                {% endif %}

                {% if slide_button_text != blank and slide_button_link != blank %}
                  <a href="{{ slide_button_link }}" class="ai-carousel-button-{{ ai_gen_id }}">
                    {{ slide_button_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-carousel-controls-{{ ai_gen_id }}">
      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-carousel-pause-{{ ai_gen_id }}"
        aria-label="Pause carousel"
      >
        <svg class="pause-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6" y="4" width="4" height="16"></rect>
          <rect x="14" y="4" width="4" height="16"></rect>
        </svg>
        <svg class="play-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
      </button>

      <div class="ai-carousel-dots-{{ ai_gen_id }}"></div>

      <button
        class="ai-carousel-nav-{{ ai_gen_id }} ai-carousel-nav-next-{{ ai_gen_id }}"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</image-text-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageTextCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.autoplayInterval = null;
        this.isPaused = false;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-carousel-track-{{ ai_gen_id }}');
        this.slideElements = this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-carousel-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-carousel-nav-next-{{ ai_gen_id }}');
        this.pauseButton = this.querySelector('.ai-carousel-pause-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-carousel-dots-{{ ai_gen_id }}');

        this.slides = Array.from(this.slideElements);
        this.totalSlides = this.slides.length;

        if (this.totalSlides === 0) return;

        this.createDots();
        this.setupEventListeners();
        this.updateCarousel();
        this.startAutoplay();
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        this.slides.forEach((_, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-carousel-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
        this.dots = this.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.previousSlide());
        this.nextButton.addEventListener('click', () => this.nextSlide());
        this.pauseButton.addEventListener('click', () => this.togglePause());

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (!this.isPaused) {
            this.startAutoplay();
          }
        });

        let touchStartX = 0;
        let touchEndX = 0;

        this.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        });

        this.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          if (touchStartX - touchEndX > 50) {
            this.nextSlide();
          } else if (touchEndX - touchStartX > 50) {
            this.previousSlide();
          }
        });
      }

      updateCarousel() {
        this.track.style.transform = `translateX(-${this.currentSlide * 100}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        this.prevButton.disabled = this.currentSlide === 0;
        this.nextButton.disabled = this.currentSlide === this.totalSlides - 1;
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateCarousel();
        this.resetAutoplay();
      }

      nextSlide() {
        if (this.currentSlide < this.totalSlides - 1) {
          this.currentSlide++;
        } else {
          this.currentSlide = 0;
        }
        this.updateCarousel();
        this.resetAutoplay();
      }

      previousSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
        } else {
          this.currentSlide = this.totalSlides - 1;
        }
        this.updateCarousel();
        this.resetAutoplay();
      }

      togglePause() {
        this.isPaused = !this.isPaused;
        
        if (this.isPaused) {
          this.pauseButton.classList.add('paused');
          this.pauseButton.setAttribute('aria-label', 'Play carousel');
          this.stopAutoplay();
        } else {
          this.pauseButton.classList.remove('paused');
          this.pauseButton.setAttribute('aria-label', 'Pause carousel');
          this.startAutoplay();
        }
      }

      startAutoplay() {
        const autoplayEnabled = {{ block.settings.autoplay }};
        const autoplaySpeed = {{ block.settings.autoplay_speed }} * 1000;

        if (autoplayEnabled && this.totalSlides > 1 && !this.isPaused) {
          this.autoplayInterval = setInterval(() => {
            this.nextSlide();
          }, autoplaySpeed);
        }
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      resetAutoplay() {
        this.stopAutoplay();
        if (!this.isPaused) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('image-text-carousel-{{ ai_gen_id }}', ImageTextCarousel{{ ai_gen_id }});
  })();
</script>

