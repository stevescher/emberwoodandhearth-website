        "text_qbXiRU": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>Emberwood & Hearth isn't just a name. It's a blueprint for everything we make. Each word carries its weight, and together they describe not just what we sell, but the feeling we're after in every product we craft.</p><ul><li><strong>Ember:</strong> Fire that has settled. Not the roar of a flame. The quiet, steady heat that lingers and fills a room.</li><li><strong>Wood:</strong> The material at the center of everything. Our wicks, our lids, our woodwork, our finishes, and the scents themselves. The thread that ties it all together.</li><li><strong>Hearth:</strong> The home. The gathering place. The room you walk into and exhale. Everything we make is designed to live there and make it feel more like itself.</li></ul>",
            "width": "100%",
            "max_width": "none",
            "alignment": "left",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
