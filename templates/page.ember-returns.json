        "text_V7BEPJ": {
          "type": "text",
          "settings": {
            "text": "<h3></h3><p>Ember Returns is currently available in person at our farmer's market and pop-up locations — bring it back next time you see us. Returns must be from Emberwood & Hearth candles only, and vessels must be clean and intact. Cracked glass or damaged lids can't be accepted. One return set per customer per visit. Discounts apply to any in-stock product and can be used the same day or saved for a future visit.</p><p>This program is subject to change, though any updates will always be posted here and will never affect discounts already issued.</p>"
          }
        }
