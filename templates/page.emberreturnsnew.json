        "text_jePrPP": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>Ember Returns is currently available in person at our farmer's market and pop-up locations — bring it back next time you see us. Returns must be from Emberwood & Hearth candles only, and vessels must be clean and intact. Cracked glass or damaged lids can't be accepted. One return set per customer per visit. Discounts apply to any in-stock product and can be used the same day or saved for a future visit.</p><p></p><p>This program is subject to change, though any updates will always be posted here and will never affect discounts already issued.</p><p></p><p>Ember Returns is available wherever you find us in person. Follow us on social or check back here for our upcoming market and event schedule.</p><p></p><p>Questions? Reach us Reach us through our <a href=\"\\&quot;/pages/contact\\&quot;\" title=\"\\&quot;Contact\">Contact Page</a>. We're a small team and we'll get back to you within a day or two.</p>",
            "width": "fit-content",
